# Vidframe: artifact build for arm64-v8a. Downloads prebuilt native Gecko libraries (libxul) from Mozilla CI
# instead of compiling C++/Rust; Java/Kotlin, JS and prefs (including vidframe-prefs.js) are still built locally.
# Use it for tests and debug APKs. Release APKs for distribution should use vidframe/mozconfigs/arm64.
ac_add_options --enable-project=mobile/android
ac_add_options --target=aarch64-linux-android
ac_add_options --enable-artifact-builds

mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-vidframe-arm64-artifact
