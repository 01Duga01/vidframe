<!-- Vidframe: the web-app shell has no menu, so settings, the add-on manager (uBlock Origin) and local history are
     reachable through launcher long-press shortcuts that use the release deep-link scheme. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="vidframe_settings"
        android:enabled="true"
        android:icon="@drawable/mozac_ic_settings_24"
        android:shortcutShortLabel="@string/vidframe_shortcut_settings">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="vidframe://settings"
            android:targetPackage="io.github.vidframe.app"
            android:targetClass="org.mozilla.fenix.HomeActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="vidframe_addons"
        android:enabled="true"
        android:icon="@drawable/mozac_ic_extension_24"
        android:shortcutShortLabel="@string/vidframe_shortcut_addons">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="vidframe://settings_addon_manager"
            android:targetPackage="io.github.vidframe.app"
            android:targetClass="org.mozilla.fenix.HomeActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="vidframe_history"
        android:enabled="true"
        android:icon="@drawable/mozac_ic_history_24"
        android:shortcutShortLabel="@string/vidframe_shortcut_history">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="vidframe://urls_history"
            android:targetPackage="io.github.vidframe.app"
            android:targetClass="org.mozilla.fenix.HomeActivity" />
    </shortcut>
</shortcuts>
