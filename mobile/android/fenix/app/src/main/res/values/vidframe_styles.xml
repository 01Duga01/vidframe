<resources>
    <!-- System splash screen of the launcher (Android 12+ natively, AndroidX backport below). -->
    <style name="Theme.Vidframe.Launcher" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/vidframe_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/vidframe_splash_icon_animated</item>
        <item name="windowSplashScreenAnimationDuration">700</item>
        <item name="postSplashScreenTheme">@style/Theme.Vidframe.Setup</item>
    </style>

    <!-- After the splash: the first-run setup screen (Compose) on the same background, edge to edge. -->
    <style name="Theme.Vidframe.Setup" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/vidframe_splash_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
