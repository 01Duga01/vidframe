<resources>
    <!-- System splash screen of the launcher (Android 12+ natively, AndroidX backport below). -->
    <style name="Theme.Vidframe.Launcher" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/vidframe_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/vidframe_splash_icon_animated</item>
        <item name="windowSplashScreenAnimationDuration">700</item>
        <item name="postSplashScreenTheme">@style/Theme.Transparent</item>
    </style>
</resources>
