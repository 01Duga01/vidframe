<!-- The badge pops in with a slight overshoot, then the frame and the "V" are drawn. 700 ms in total. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/vidframe_splash_icon">
    <target android:name="badge">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="380"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleX"
                    android:valueFrom="0.6"
                    android:valueTo="1" />
                <objectAnimator
                    android:duration="380"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleY"
                    android:valueFrom="0.6"
                    android:valueTo="1" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="frame">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <!-- Hide the stroke at t=0; an offset animator alone would show it until it starts. -->
                <objectAnimator
                    android:duration="0"
                    android:propertyName="trimPathEnd"
                    android:valueFrom="0"
                    android:valueTo="0" />
                <objectAnimator
                    android:duration="320"
                    android:startOffset="200"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="trimPathEnd"
                    android:valueFrom="0"
                    android:valueTo="1" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="mark">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <!-- Hide the stroke at t=0; an offset animator alone would show it until it starts. -->
                <objectAnimator
                    android:duration="0"
                    android:propertyName="trimPathEnd"
                    android:valueFrom="0"
                    android:valueTo="0" />
                <objectAnimator
                    android:duration="260"
                    android:startOffset="440"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="trimPathEnd"
                    android:valueFrom="0"
                    android:valueTo="1" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
