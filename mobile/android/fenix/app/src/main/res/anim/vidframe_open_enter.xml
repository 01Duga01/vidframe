<!-- The site rises into place: fade in while scaling from 94 % with a decelerating curve. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic"
    android:shareInterpolator="true">
    <alpha
        android:duration="260"
        android:fromAlpha="0"
        android:toAlpha="1" />
    <scale
        android:duration="320"
        android:fromXScale="0.94"
        android:fromYScale="0.94"
        android:pivotX="50%"
        android:pivotY="50%"
        android:toXScale="1"
        android:toYScale="1" />
</set>
