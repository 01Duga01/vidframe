{
  "manifest_version": 2,
  "name": "Vidframe UI",
  "version": "1.1.0",
  "description": "Built-in page styles and player features (pinch zoom, miniplayer) for the Vidframe client.",
  "browser_specific_settings": {
    "gecko": {
      "id": "ui@vidframe"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://m.youtube.com/*"
      ],
      "css": [
        "m-youtube.css"
      ],
      "run_at": "document_start",
      "js": [
        "player.js"
      ]
    },
    {
      "matches": [
        "https://accounts.google.com/*",
        "https://consent.youtube.com/*",
        "https://consent.google.com/*"
      ],
      "css": [
        "account-pages.css"
      ],
      "run_at": "document_start"
    }
  ]
}
